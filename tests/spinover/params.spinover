from params_default import default_params
import numpy as np

# Spin-over mode at Ek = 1e-3: hydrodynamic only, no-slip, ricb = 0.35
par = default_params()

par.m        = 1
par.symm     = -1
par.Ek       = 1e-3

par.ncpus    = 2
par.N        = 68   # same resolution as the spin-over test in the main branch (int(17*Ek**-0.2), even)
par.lmax     = 64

par.nev      = 5
par.tol      = 1e-15
par.prescale = 0    # as for the reference

par.set_scales()
