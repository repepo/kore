from params_default import default_params
import numpy as np

# Torsional modes of the quadrupolar field S2 of Luo & Jackson (2022): inviscid full sphere, insulating boundary,
# Lehnert number 1e-4, Lundquist number 2/Le (Elsasser number 1), Alfvén time scale, m = 0
par = default_params()

par.ricb      = 0
par.Ek        = 0
par.magnetic  = 1
par.B0        = 'Luo_S2'
par.cnorm     = 'mag_energy'  # unit magnetic energy as in Luo & Jackson 2022
par.c_cmb     = 1e-2          # not used: the mantle is an insulator
par.c1_cmb    = 1.5e-2

Lu            = 2e4
par.Le        = 1e-4
par.Em        = par.Le/Lu
par.timescale = 'Alfven'

par.ncpus     = 2
par.N         = 128           # set manually (Ncheb is for viscous runs)

par.rtau      = -0.0142       # mode 2
par.itau      = 1.9095

par.set_scales()
